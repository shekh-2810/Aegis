# MongoDB Atlas connection string
MONGO_URI=your_mongodb_atlas_connection_string

# Secret used to sign JWTs. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_value

# JWT lifetime in minutes
JWT_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------
# Optional — the app works fully without any of these set. Each
# feature below silently falls back to its non-AI/non-API version
# if its key is missing.
# ---------------------------------------------------------------

# Google Safe Browsing (free tier): adds a live threat-list check to
# /api/detect alongside the local heuristics.
# Get a key: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal (free tier): adds a multi-vendor URL reputation check to
# /api/detect alongside the local heuristics.
# Get a key: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# Anthropic API key: if set, incident report generation (Stage 2) uses
# Claude to polish the summary/recommendations text. Without it, the
# deterministic template generator is used (and always runs first either
# way, so this is a pure enhancement, never a requirement).
# Get a key: https://console.anthropic.com
ANTHROPIC_API_KEY=
